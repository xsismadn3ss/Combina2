# Credenciales SOLO para desarrollo local (compose + tests).
# Copia este archivo a `.env` (gitignored) y ajusta si hace falta.
POSTGRES_USER=combina2
POSTGRES_PASSWORD=combina2
POSTGRES_DB=combina2
POSTGRES_TRAINING_DB=combina2_training
POSTGRES_PORT=5432

# Runtime/feedback y datos de entrenamiento (dos bases separadas).
# En Railway SOLO se define DATABASE_URL; TRAINING_DATABASE_URL se queda local.
DATABASE_URL=postgresql+psycopg://combina2:combina2@localhost:5432/combina2
TRAINING_DATABASE_URL=postgresql+psycopg://combina2:combina2@localhost:5432/combina2_training

# Token Bearer de GET /api/v1/feedback/export.csv.
# Vacío = export deshabilitado (404). Para habilitarlo, genera uno, p. ej.:
#   openssl rand -hex 32
FEEDBACK_EXPORT_TOKEN=

# Timeout de conexión a Postgres en segundos.
DB_CONNECT_TIMEOUT=5
