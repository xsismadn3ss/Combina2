@inject NavigationManager Navigation
@inject IJSRuntime JS

<section class="return-title-container">
    <button title="volver" @onclick="Return">
        <SvgIcon Name="chevron-left" Color="rgba(var(--primary))" />
    </button>
    <h3>@Title</h3>
    <button style="opacity: 0">hello</button>
</section>

<section class="return-title-shadow"></section>
<section class="return-title-safe-area"></section>

<script>
    function goBack(){
        history.back();
    }
</script>

@code {
    [Parameter] public string Title { get; set; } = String.Empty;

    private async Task Return()
    {
        await JS.InvokeVoidAsync("goBack");
    }
}

