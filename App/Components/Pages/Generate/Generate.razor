@page "/generate"
@using Combina2.Components.Pages.Generate.Components
@inject GStateMachine StateMachine

<ReturnTitle title="Generate" />

<section class="container">
    <div class="gbi-form">
        <UploadImage />
        <ImagePreview />
        <ColorPonderanceList />
        <SubmitButton />
    </div>
</section>

@code {
    // Hacer reset al servicio cuando se desmonta el componente
    protected override async Task OnInitializedAsync()
    {
        await StateMachine.Reset();
    }
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            StateMachine.OnAfterRender();
        }
    }
}

