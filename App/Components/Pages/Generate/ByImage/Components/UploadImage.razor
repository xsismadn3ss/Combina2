@using Combina2.Components.Features
@inject GBI_StateMachine StateMachine

<div class="upload-img-container" style="--img-visible:@btnOpacity;">
    <label for="file-input">
        <div class="upload-img-button {@btnOpacity}">
            <SvgIcon Name="image-plus" Color="white" Size="50px" />
        </div>
    </label>
    <InputFile id="file-input" OnChange="OnInputFileChange" hidden="hidden" />
</div>

@code {
    private string btnOpacity =>
        StateMachine.FormState.Image == null && !StateMachine.FormState.Loading ? "1.0" : "0.0";

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;

        // Convertir a array de bytes
        using var ms = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 10_000_000).CopyToAsync(ms);
        var originalBytes = ms.ToArray();

        // Actualizar estado a subiendo imagen
        StateMachine.FormState.Loading = true; // Notificar que se esta cargando la imagen
        StateMachine.NotifyStateChanged();

        await Task.Yield();

        // Comprimir imagen
        var compressedImage = await Task.Run(() => ImageHelper.CompressImage(originalBytes, 50));
        var imagePreview = $"data:image/jpeg;base64,{Convert.ToBase64String(compressedImage)}";
        // Actualizar estado
        StateMachine.FormState.Image = compressedImage;
        StateMachine.FormState.ImagePreview = imagePreview;
        StateMachine.FormState.Loaded = true; // Agregar que ya se cargó la imagen
        StateMachine.NotifyStateChanged();

    }

    protected override void OnInitialized()
    {
        StateMachine.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        StateMachine.OnChange -= StateHasChanged;
    }
}
