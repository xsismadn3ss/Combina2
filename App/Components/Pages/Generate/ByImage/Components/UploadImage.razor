@using Combina2.Components.Features
@inject GBI_StateMachine StateMachine

<div class="upload-img-container" style="--img-visible:@btnOpacity;">
    <label for="file-input">
        <div class="upload-img-button {@btnOpacity}">
            <SvgIcon Name="image-plus" Color="white" Size="50px" />
        </div>
    </label>
    <InputFile id="file-input" OnChange="OnInputFileChange" hidden="hidden" />
</div>

@code {
    private string btnOpacity => StateMachine.Image == null ? "1.0" : "0.0";

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;

        // Convertir a array de bytes
        using var ms = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 10_000_000).CopyToAsync(ms);
        var originalBytes = ms.ToArray();

        // Comprimir imagen
        var compressedImage = ImageHelper.CompressImage(originalBytes, 50);

        // Actualizar estado
        StateMachine.SetImage(compressedImage);
        StateMachine.SetImagePreview($"data:image/jpeg;base64,{Convert.ToBase64String(compressedImage)}");
    }

    protected override void OnInitialized()
    {
        StateMachine.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        StateMachine.OnChange -= StateHasChanged;
    }
}
