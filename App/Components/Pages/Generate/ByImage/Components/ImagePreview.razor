@inject GBI_StateMachine StateMachine


@if (!String.IsNullOrEmpty(StateMachine.ImagePreview))
{
    <div class="image-preiew-container">
        <img class="image-preview" src="@StateMachine.ImagePreview" />
    </div>
}

<style>
    .image-preiew-container{
        display: flex;
        justify-content: center;
    }
    .image-preview{
        max-width: 90vw;
        height: auto;
        border: 1px solid rgba(var(--primary));
        border-radius: 1rem;
        box-shadow: 0px 0px 20px 5px rgba(var(--secondary));
        overflow: hidden;
    }
</style>

@code {
    protected override void OnInitialized()
    {
        StateMachine.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        StateMachine.OnChange -= StateHasChanged;
    }
}
