@using Combina2.Models
@using Combina2.Services
@inject IColorPonderanceService ColorPonderanceService
@inject GStateMachine State
@implements IDisposable


@if (Visible)
{
    <div class="colors-root">
        <div class="colors-container">
            <h2>Colores frecuentes</h2>
            <p class="container-description">Selecciona dos colores o más para generar una paleta</p>
            <div class="colors-list">

            @foreach (var color in Colors)
            {
                <div class="color-item">
                    <div class="color-circle" style="background-color: #@color.Color;"></div>
                    <p>#@color.Color</p>
                    <p>@color.Percentage.ToString("F2")%</p>
                </div>
            }
            </div>
        </div>
    </div>
}


@code {
    private List<ColorPonderance> Colors { get; set; } = [];

    private bool Visible =>
        State.FormState.Loaded && State.FormState.Image != null;

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    private async void OnStateChanged()
    {
        if (State.FormState.Image is not { Length: > 0 }) return;
        Colors = ColorPonderanceService.GetPonderances(State.FormState.Image).ToList();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }
}