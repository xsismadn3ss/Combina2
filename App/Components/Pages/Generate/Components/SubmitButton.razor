@inject GStateMachine State

<FloatingButton Disable="@disableButton" @onclick="HandleClick">
    Generar
</FloatingButton>

@code {
    private bool disableButton => !State.FormState.IsValidForm;

    private async Task HandleClick()
    {
        throw new NotImplementedException("Aún no esta implementado el metodo HandleClick");
    }

    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
}