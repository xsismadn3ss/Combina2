@using Combina2.Components.Features
@inject GStateMachine StateMachine

<div class="image-preview-container" style="--preview-opacity:@PreviewOpacity">
    <div class="image-border">
        <img class="image-preview" src="@StateMachine.FormState.ImagePreview" />
        <div class="image-remove-btn" @onclick="RemoveImage">
            <SvgIcon Name="x" Color="white" />
        </div>
    </div>
    <div class="image-preview-spinner" style="--spinner-opacity:@SpinnerOpacity">
        <Spinner Size="70px" />
    </div>
</div>


@code {
    private string PreviewOpacity =>
            String.IsNullOrEmpty(StateMachine.FormState.ImagePreview) ? "0.0" : "1.0";

    private string SpinnerOpacity =>
            StateMachine.FormState.ImageLoading && !StateMachine.FormState.ImageLoaded ? "1.0" : "0.0";

    private async Task RemoveImage()
    {
        await StateMachine.Reset();
    }

    protected override void OnInitialized()
    {
        StateMachine.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        StateMachine.OnChange -= StateHasChanged;
    }
}
