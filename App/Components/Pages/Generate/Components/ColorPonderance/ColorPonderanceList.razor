@using Combina2.Services
@inject IColorPonderanceService ColorPonderanceService
@inject GStateMachine State
@implements IDisposable


@if (Visible)
{
    <div class="colors-root">
        <div class="colors-container">
            <h2 style="margin: 0;">Colores frecuentes</h2>
            <p class="container-description">Selecciona dos colores o más para generar una paleta</p>
            <div class="colors-list">
                @foreach (var color in State.FormState.Colors)
                {
                    <ColorPonderanceItem color="@color" />
                }
            </div>
        </div>
    </div>
}


@code {
    private bool Visible => State.FormState.Step == 1;

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    private async void OnStateChanged()
    {
        if (State.FormState.Image is not { Length: > 0 })
        {
            State.FormState.Colors = [];
            await InvokeAsync(StateHasChanged);
            return;
        }
        State.FormState.Colors = ColorPonderanceService.GetPonderances(State.FormState.Image).ToList();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }
}