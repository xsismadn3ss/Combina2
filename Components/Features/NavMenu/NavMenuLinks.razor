@inject NavMenuState State
@implements IDisposable

@code {
    private List<LinkModel> Links = new()
    {
        new()
        {
            Name = "Generate", IconName="sparkles", Href="/generate"
        },
        new()
        {
            Name = "Identify", IconName="scan-search", Href = "/identify"
        }
    };

    protected override void OnInitialized()
    {

        State.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
}

<nav class="links-root">
    <div class="@($"links-container {(State.MenuVisible ? "pop-up" : "")}")">
        <ul class="@($"links-list {(State.MenuVisible ? "" : "invisible")}")">
            @foreach (var link in Links)
            {
                <NavMenuLink link="@link" />
            }
        </ul>
    </div>

</nav>