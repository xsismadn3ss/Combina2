@inject NavMenuState State
@implements IDisposable

@code {
    private List<LinkModel> Links = new()
    {
        new()
        {
            Name = "Generate", IconName="sparkles", Href="/generate"
        },
        new()
        {
            Name = "Identify", IconName="scan-search", Href = "/identify"
        },
        new()
        {
            Name = "Config", IconName="cog", Href = "/config"
        }
    };

    private string inOut => State.MenuVisible ? "in" : "out";

    protected override void OnInitialized()
    {

        State.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
}

<nav class="links-root">
    <div class="@($"links-container {(State.MenuVisible ? "pop-up" : "")}")">
        <div class="fade @inOut">
             <ul class="links-list">
               <NavMenuLink link="@Links[0]" />
                <NavMenuLink link="@Links[1]" />
            </ul>
            <ul class="links-list">
                <NavMenuLink link="@Links[2]" />
            </ul>
        </div>
    </div>
</nav>