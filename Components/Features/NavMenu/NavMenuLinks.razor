@using System.ComponentModel.DataAnnotations
@inject NavMenuState State
@implements IDisposable

@code {
    public sealed class NavMenuLink
    {
        [Required]
        public string Name { get; set; } = String.Empty;
        public string Href { get; set; } = "/";
    }

    private List<NavMenuLink> Links = new()
    {
        new()
        {
            Name = "Home"
        },
        new()
        {
            Name = "Generate",
            Href = "/generate"
        }
    };

    protected override void OnInitialized()
    {

        State.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
}

<nav class="links-root">
    <div class="@($"links-container {(State.MenuVisible ? "pop-up" : "")}")">
    <ul class="links-list">
        @foreach (var link in Links)
        {
            <li>
                <a href="@link.Href">@link.Name</a>
            </li>
        }
    </ul>
</div>

</nav>